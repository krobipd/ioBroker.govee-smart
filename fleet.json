{
  "_comment": "Adapter-specific declarations for the fleet tooling (Entwicklung/scripts). They live HERE so that a change in this adapter never touches the locked tooling. Readers: sync-iopackage-from-i18n.py (manifestI18n, release gate B03) and submit-stable.py (forumThread). Keys starting with an underscore are comments.",
  "manifestI18n": {
    "_comment": "instanceObjects id -> key in admin/i18n/<lang>.json. Every manifest object needs a `name` entry (an object without one is a structural error, and so is an entry whose object no longer exists); `desc` only where the name does not already say it - an empty desc beats an invented sentence.",
    "name": {
      "info": "information",
      "info.connection": "infoConnection",
      "info.mqttConnected": "infoMqttConnected",
      "info.cloudConnected": "infoCloudConnected",
      "info.openapiMqttConnected": "infoOpenapiMqttConnected",
      "devices": "devicesFolder",
      "groups": "groups",
      "info.manualSyncDevices": "infoManualSyncDevices",
      "info.verificationPending": "infoVerificationPending"
    },
    "desc": {
      "info.connection": "infoConnectionDesc",
      "info.mqttConnected": "infoMqttConnectedDesc",
      "info.cloudConnected": "infoCloudConnectedDesc",
      "info.manualSyncDevices": "infoManualSyncDevicesDesc",
      "info.openapiMqttConnected": "infoOpenapiMqttConnectedDesc",
      "info.verificationPending": "infoVerificationPendingDesc"
    }
  },
  "deviceIds": "unit",
  "forumThread": "https://forum.iobroker.net/topic/84712/test-adapter-govee-smart-2.14.1",
  "listenPorts": [
    {
      "_comment": "UDP 4002 is where Govee LAN devices send their replies (protocol-fixed, ports table on the Setup wiki page); the discovery multicast 4001 and the command port 4003 belong to the devices, not to this instance.",
      "key": "port",
      "protocol": "udp",
      "role": "primary",
      "fixed": 4002
    }
  ],
  "serverTest": {
    "_why": "Proves on the real account what fixtures cannot: the account broker (own PKCS#12 reader), the OpenAPI events broker and the cloud REST path come up, every device keeps its model and name, and one light really switches over its own channel and confirms by its device report.",
    "_observe": "150 s covers one full App API cycle (APP_API_POLL_INTERVAL_MS, 2 min) — the longest periodic cycle that can log a warning.",
    "_spacing": "A start reuses the persisted bearer and P12 (tryPersistedReuse in govee-mqtt-client.ts) and sends no login while the token is valid; the account lockout of 2026-04-19 (5 restarts in 1 h, CLAUDE_RELEASE.md) predates that reuse. What binds across starts are the per-process caps in src/lib/api-limits.json: the OpenAPI events broker connects at most once a minute and the App Store lookup is capped at 2 per 60 s — 60 s apart keeps both.",
    "_command": "control.power on a LAN-driven light is confirmed only by the device's own status report (GV-13, confirmation.ts), so the commanded state is its own confirmation. Groups are left out: one toggle switches several lights and the group acknowledges itself. Govee has no wake state — a light without power falls through to asking krobi.",
    "observeSeconds": 150,
    "connectSeconds": 60,
    "startSpacingSeconds": 60,
    "reads": [
      { "id": "info.connection", "expect": "true" },
      { "id": "info.cloudConnected", "expect": "true" },
      { "id": "info.mqttConnected", "expect": "true" },
      { "id": "info.openapiMqttConnected", "expect": "true" },
      { "id": "info.devicesTotal", "expect": "number" },
      { "id": "devices.*.info.model", "expect": "nonEmpty" },
      { "id": "devices.*.info.name", "expect": "nonEmpty" }
    ],
    "commands": [
      {
        "id": "devices.*.control.power",
        "online": "devices.*.info.online",
        "value": "toggle",
        "timeoutSeconds": 30
      }
    ]
  },
  "ciExtraJobs": {
    "_comment": "Extra CI jobs beyond the fleet's core jobs — each costs runtime in every run, so each carries its reason.",
    "validate-devices": "devices.json is the device catalog the adapter ships: its schema, statuses and quirk fields are validated on every push (npm run validate-devices), a broken entry would break every installation's quirk loading"
  },
  "suites": {
    "_comment": "What the fleet suites (test/fleet-suites.js, round 124) need to know about govee-smart: the connection test is the account card's login probe; the fixture hooks of test/inventory.js honour INVENTORY_RENAME (first device renamed in the account list), INVENTORY_REJECT_LOGIN (Govee's answer to a wrong password) and INVENTORY_DROP_DEVICE (the LAN light answers nothing, it stays in the account list).",
    "connectionTest": { "command": "mqttAuth", "message": { "action": "test" }, "spacingMs": 30000 },
    "groupSwitches": {
      "none": "no admin setting adds or removes a group of datapoints; experimentalQuirks only switches the catalogue quirks of untested models"
    },
    "rename": true,
    "rejectLogin": true,
    "dropDevice": true
  },
