{
  "instance": "govee-smart.0",
  "targets": [
    {
      "name": "connection",
      "tab": "Main|Haupt",
      "mountSelectors": [
        "[data-testid=\"dot-lan\"]"
      ],
      "probe": [
        {
          "expectDisabled": "[data-testid=\"conn-connect\"]"
        },
        {
          "fill": "[data-testid=\"conn-email\"]",
          "value": "render-check@example.com"
        },
        {
          "fill": "[data-testid=\"conn-password\"]",
          "value": "render-check-probe"
        },
        {
          "expectEnabled": "[data-testid=\"conn-connect\"]"
        }
      ]
    },
    {
      "name": "wizard",
      "tab": "Segment",
      "mountSelectors": [
        "[data-testid=\"wiz-start\"]",
        "[data-testid=\"wiz-no-devices\"]"
      ],
      "gold": {
        "when": "[data-testid=\"wiz-start\"]",
        "value": "[data-testid=\"wiz-device-select\"]"
      }
    },
    {
      "name": "diagnostics",
      "tab": "Diagnostics|Diagnose",
      "mountSelectors": [
        "[data-testid=\"diag-export\"]",
        "[data-testid=\"diag-no-devices\"]"
      ],
      "gold": {
        "when": "[data-testid=\"diag-export\"]",
        "value": "[data-testid=\"diag-device-select\"]"
      }
    }
  ]
}
